# Copy to .env for local runs:  cp .env.example .env
# .env is git-ignored. Never commit a real key.

# Optional. When set, the app uses this key if the sidebar field is empty.
# Leave it unset on any public deployment, otherwise every visitor spends your quota.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Comma-separated Gemini models for answers, tried in order.
# Defaults are in app/job_assistant/config.py.
# GEMINI_MODELS=model-a,model-b
